{
  "manifest_version": 3,
  "name": "Canvas 文件助手",
  "version": "1.0.0",
  "description": "遍历当前课程全部 Modules，按格式和章节整理附件，勾选批量下载。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_title": "整理当前 Canvas 课程的文件"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icon.png"
  }
}
